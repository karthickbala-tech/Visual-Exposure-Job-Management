# Copy this file to ".env" (same folder) and fill in the values. ".env" is ignored by git and is never committed.
# Nobody (including Claude) needs to read your .env: the scripts in /scripts read it on your machine.
#
# `node scripts/deploy-env.mjs` deploys the functions and makes the Catalyst environment variables match THIS file.
# A variable that is empty or missing here is REMOVED from Catalyst on the next deploy, so keep everything below filled in.

# --- App ---
APP_URL=https://visualexposure-60093485853.development.catalystserverless.in/app/index.html
STRATUS_BUCKET=ve-files-dev

# Created for you by deploy-env.mjs the first time if left empty. Use it as the "x-webhook-token" header in the CRM webhook.
CRM_WEBHOOK_SECRET=

# Email sender. Two ways; leave both empty to keep email switched off.
# 1. Catalyst Mail: a sender address on a domain verified in the Catalyst console.
MAIL_FROM=
# 2. SMTP, for testing and demos (no domain needed). For Gmail use an "app password", never your normal password.
#    If both are set, SMTP is used. SMTP_HOST and SMTP_PORT default to Gmail (smtp.gmail.com, 465).
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=

# --- Zoho (CRM and WorkDrive) ---
# Zoho data center: the ending of your CRM address (crm.zoho.in -> in, crm.zoho.com -> com, crm.zoho.com.au -> com.au)
ZOHO_DC=in

# From the Zoho API console > your Self Client
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# From the Self Client "Generate Code" tab. Works once and expires in 10 minutes: fill it in right before running
# `node scripts/zoho-token.mjs`, which then writes ZOHO_REFRESH_TOKEN below for you and blanks this line.
ZOHO_CODE=

# Written by scripts/zoho-token.mjs. You do not type this one.
ZOHO_REFRESH_TOKEN=

# The WorkDrive folder that job folders are created in (the last part of the folder's web address).
WORKDRIVE_PARENT_FOLDER_ID=
